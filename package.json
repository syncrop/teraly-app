{
  "name": "teraly---mental-health-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "audit:front:angular21": "node ./scripts/audit-angular21-front.mjs",
    "audit:front:angular21:strict": "node ./scripts/audit-angular21-front.mjs --strict",
    "build:ios": "ng build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "ng build && npx cap sync ios && npx cap open ios",
    "preview": "ng serve --configuration=production",
    "test": "karma start karma.conf.cjs",
    "test:headless": "karma start karma.conf.cjs --browsers=ChromeHeadlessCI --single-run",
    "test:coverage": "karma start karma.conf.cjs --browsers=ChromeHeadlessCI --single-run --code-coverage"
  },
  "dependencies": {
    "@angular/build": "21.0.6",
    "@angular/cli": "21.0.6",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/compiler-cli": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "21.0.6",
    "@angular/localize": "21.0.6",
    "@angular/platform-browser": "21.0.6",
    "@angular/router": "21.0.6",
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/app": "^6.0.1",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.3",
    "@tensorflow-models/toxicity": "^1.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "agora-rtc-sdk-ng": "^4.24.2",
    "livekit-client": "^2.16.1",
    "rxjs": "^7.8.2",
    "stream-chat": "^9.18.1",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.0.6",
    "@capacitor/cli": "8.0.0",
    "@types/node": "^22.14.0",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "5.9",
    "vite": "^6.2.0"
  }
}
